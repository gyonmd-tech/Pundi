# Appwrite Cloud Credentials — do not wrap Vercel values in quotes
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_APPWRITE_DATABASE_ID=pundi-db
APPWRITE_API_KEY=your_api_key_here

# Penjaga — Hermes Agent (opsional). Lihat docs/PENJAGA_HERMES.md.
# URL API server Hermes yang dapat dijangkau server Pundi (boleh diakhiri /v1).
HERMES_API_URL=
# Nilai API_SERVER_KEY di ~/.hermes/.env
HERMES_API_KEY=
# Nama model/profil Hermes (default: hermes-agent)
HERMES_MODEL=hermes-agent
# Email akun Pundi yang boleh memakai chat Hermes di aplikasi (pisahkan dengan koma)
PENJAGA_OWNER_EMAILS=
